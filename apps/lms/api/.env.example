# LMS/Training API — copy to .env and adjust.
PORT=4004
DATABASE_URL=postgres://hr:hr@localhost:5432/lms
# Frontend origins allowed to send cookies (comma-separated).
WEB_ORIGIN=http://localhost:3004
BETTER_AUTH_URL=http://localhost:4004
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-secret
LOG_LEVEL=info
