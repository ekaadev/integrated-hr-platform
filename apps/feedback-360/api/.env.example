# 360 Feedback API — salin ke .env lalu sesuaikan.
PORT=4003
DATABASE_URL=postgres://hr:hr@localhost:5432/feedback_360
# Origin frontend yang boleh mengirim cookie (pisahkan dengan koma).
WEB_ORIGIN=http://localhost:3003
BETTER_AUTH_URL=http://localhost:4003
# Buat dengan: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-secret
LOG_LEVEL=info
# Model lokal untuk AI pipeline (Ollama di mesin yang memiliki GPU).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
