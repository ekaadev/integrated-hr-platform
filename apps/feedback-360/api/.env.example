# 360 Feedback API — copy to .env and adjust.
PORT=4003
DATABASE_URL=postgres://hr:hr@localhost:5432/feedback_360
# Frontend origins allowed to send cookies (comma-separated).
WEB_ORIGIN=http://localhost:3003
BETTER_AUTH_URL=http://localhost:4003
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-secret
LOG_LEVEL=info
# Local model for the AI pipeline (Ollama on a machine with a GPU).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
