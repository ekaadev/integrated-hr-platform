# KPI/Performance API — salin ke .env lalu sesuaikan.
PORT=4002
DATABASE_URL=postgres://hr:hr@localhost:5432/kpi
# Origin frontend yang boleh mengirim cookie (pisahkan dengan koma).
WEB_ORIGIN=http://localhost:3002
BETTER_AUTH_URL=http://localhost:4002
# Buat dengan: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-secret
LOG_LEVEL=info
