{
  "name": "@hr/kpi-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "build": "bun build src/index.ts src/db/migrate.ts --target bun --outdir dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun src/db/seed.ts",
    "auth:generate": "auth generate --config src/auth.ts --output src/db/schema/auth.ts -y"
  },
  "dependencies": {
    "@elysiajs/cors": "catalog:",
    "@elysiajs/openapi": "catalog:",
    "@hr/data-contract": "workspace:*",
    "@sinclair/typebox": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "elysia": "catalog:",
    "pino": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@hr/config": "workspace:*",
    "@types/bun": "catalog:",
    "auth": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
